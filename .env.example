# PostgreSQL used by the .NET API and shared JS database package.
# Mac: Docker Compose (preferred) or native Homebrew Postgres.
#   ./scripts/db.sh up
#   ./scripts/db.sh restore-snapshots
#   ./scripts/db.sh status
# If Homebrew already uses 5432, run Docker on 5433:
#   SILA_PG_PORT=5433 ./scripts/db.sh up
# Prefer DATABASE_URL in cloud hosts. Local .NET also accepts User Secrets:
#   dotnet user-secrets set ConnectionStrings:DefaultConnection "Host=localhost;Port=5432;Database=sila_me;Username=sila;Password=..."
# Local Docker Compose example:
# DATABASE_URL=postgresql://sila:sila@127.0.0.1:5432/sila_me
# Hosted Neon / Supabase example (keep sslmode=require):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=
# Optional Npgsql keyword form (same database as DATABASE_URL):
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=sila_me;Username=sila;Password=

# Backend OCR (scanned PDFs/images) needs Tesseract + Poppler:
#   ./scripts/install-ocr-tools.sh
#   Mac: brew install tesseract poppler
# Then restart the API. Check GET /api/dev/database-status → ocr.tesseract / ocr.pdftoppm.

# Optional. Defaults to 8080 when the API is started without --urls.
PORT=8080

# Development | Production | Testing
ASPNETCORE_ENVIRONMENT=Development

# Comma-separated browser origins allowed for cookie-authenticated Cloud login.
# SILA_ME_CORS_ORIGINS=http://localhost:5173,https://your-cloud-app.example

# Optional development-only seed accounts (ignored unless ASPNETCORE_ENVIRONMENT=Development).
# SILA_ME_CLOUD_ADMIN_PASSWORD=
# SILA_ME_MOBILE_ADMIN_PASSWORD=
# SILA_ME_ADMIN_PASSWORD=

# Optional Microsoft Graph / SharePoint integration.
# Microsoft__TenantId=
# Microsoft__ClientId=
# Microsoft__ClientSecret=
# Microsoft__RedirectUri=
# Microsoft__TokenEncryptionKey=
